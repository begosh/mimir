{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mycroft worker record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "attempt", "status", "answer", "sources", "claims", "gaps", "requests", "issues", "coverage"],
  "properties": {
    "schema_version": {"const": "mycroft.worker.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["succeeded", "partial", "failed"]},
    "answer": {"type": "string"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "requests": {"type": "array", "items": {"$ref": "#/$defs/request"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["searched", "read", "unread", "limitations"], "properties": {
      "searched": {"$ref": "#/$defs/strings"}, "read": {"$ref": "#/$defs/strings"}, "unread": {"$ref": "#/$defs/strings"}, "limitations": {"$ref": "#/$defs/strings"}
    }}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object", "additionalProperties": false,
      "required": ["id", "locator", "retrieval_type", "retrieved_at", "excerpt", "span", "identity"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1},
        "retrieval_type": {"enum": ["local_file", "primary_document", "web_page", "search_snippet", "abstract", "worker_report"]},
        "retrieved_at": {"type": ["string", "null"]}, "excerpt": {"type": "string", "minLength": 1},
        "span": {"type": "string", "minLength": 1}, "identity": {"type": ["string", "null"]}
      }
    },
    "claim": {"type": "object", "additionalProperties": false,
      "required": ["id", "text", "source_ids", "support_status", "rationale"],
      "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "source_ids": {"$ref": "#/$defs/strings"}, "support_status": {"enum": ["supported", "inference", "contradicted", "unsupported"]}, "rationale": {"type": "string", "minLength": 1}}
    },
    "request": {"type": "object", "additionalProperties": false,
      "required": ["question", "source_scope", "reason", "stop_condition"],
      "properties": {"question": {"type": "string"}, "source_scope": {"$ref": "#/$defs/strings"}, "reason": {"type": "string"}, "stop_condition": {"type": "string"}}
    },
    "issue": {"type": "object", "additionalProperties": false,
      "required": ["claim_ids", "severity", "description", "source_ids", "remedy"],
      "properties": {"claim_ids": {"$ref": "#/$defs/strings"}, "severity": {"enum": ["material", "minor"]}, "description": {"type": "string"}, "source_ids": {"$ref": "#/$defs/strings"}, "remedy": {"type": "string"}}
    }
  }
}
